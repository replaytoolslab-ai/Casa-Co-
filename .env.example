# Server-only Gemini API key. Configure this in Vercel Project Settings > Environment Variables.
# Never prefix this key with VITE_ and never expose it in client-side code.
GEMINI_API_KEY=""

# Optional model overrides. Defaults are gemini-3.8-flash and gemini-nano-banana-2.1.
GEMINI_CHAT_MODEL="gemini-3.8-flash"
GEMINI_IMAGE_MODEL="gemini-nano-banana-2.1"
